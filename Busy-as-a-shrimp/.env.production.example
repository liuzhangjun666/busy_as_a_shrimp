NODE_ENV=production
API_PORT=8081
WEB_PORT=3000
ADMIN_PORT=3002

MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_ROOT_PASSWORD=replace_with_mysql_root_password
MYSQL_PASSWORD=replace_with_mysql_root_password
MYSQL_DATABASE=busy_as_a_shrimp
DATABASE_URL=mysql://root:replace_with_mysql_root_password@mysql:3306/busy_as_a_shrimp

REDIS_HOST=redis
REDIS_PORT=6379

RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=replace_with_rabbitmq_user
RABBITMQ_PASSWORD=replace_with_rabbitmq_password

ELASTICSEARCH_NODE=http://elasticsearch:9200

JWT_SECRET=replace_with_secure_jwt_secret
JWT_EXPIRES_IN=7d

ADMIN_USERNAME=replace_with_admin_username
ADMIN_PASSWORD=replace_with_admin_password
ADMIN_TOKEN_SECRET=replace_with_admin_token_secret
ADMIN_TOKEN_TTL_SECONDS=28800

NEXT_PUBLIC_API_BASE_URL=https://api.yourdomain.com/api/v1
NEXT_PUBLIC_APP_ENV=prod
APP_PUBLIC_BASE_URL=https://api.yourdomain.com

OPENCLAW_BASE_URL=https://openclaw.yourdomain.com
OPENCLAW_API_KEY=replace_with_openclaw_token
AI_ENGINE_BASE_URL=http://ai-engine:8088

DEERFLOW_BASE_URL=https://deerflow.yourdomain.com/api/langgraph
DEERFLOW_GATEWAY_BASE_URL=https://deerflow.yourdomain.com
DEERFLOW_API_KEY=
DEERFLOW_ASSISTANT_ID=lead_agent
DEERFLOW_GRAPH_ID=lead_agent
DEERFLOW_CALLBACK_SECRET=replace_with_callback_secret
DEERFLOW_CALLBACK_TOKEN=replace_with_callback_token

TENCENTCLOUD_SECRET_ID=replace_with_tencent_secret_id
TENCENTCLOUD_SECRET_KEY=replace_with_tencent_secret_key
TENCENTCLOUD_FACEID_REGION=ap-beijing
TENCENTCLOUD_FACEID_ENDPOINT=faceid.tencentcloudapi.com
TENCENTCLOUD_FACEID_TIMEOUT=30

TENCENTCLOUD_SMS_SDK_APP_ID=replace_with_sms_sdk_app_id
TENCENTCLOUD_SMS_SIGN_NAME=replace_with_sms_sign_name
TENCENTCLOUD_SMS_TEMPLATE_ID=replace_with_sms_template_id
TENCENTCLOUD_SMS_REGION=ap-beijing
TENCENTCLOUD_SMS_ENDPOINT=sms.tencentcloudapi.com
TENCENTCLOUD_SMS_TIMEOUT=15
SMS_CODE_TTL_SECONDS=300
SMS_CODE_MAX_ATTEMPTS=5
SMS_SEND_COOLDOWN_SECONDS=60
SMS_DEBUG_BYPASS_ENABLED=false
SMS_DEBUG_BYPASS_CODE=123456

COMPLIANCE_PROVIDER=aliyun
ALIYUN_ACCESS_KEY_ID=replace_with_aliyun_access_key_id
ALIYUN_ACCESS_KEY_SECRET=replace_with_aliyun_access_key_secret
ALIYUN_GREEN_ENDPOINT=green-cip.cn-shanghai.aliyuncs.com
ALIYUN_GREEN_TEXT_SERVICE=comment_detection
ALIYUN_GREEN_AI_TEXT_SERVICE=llm_response_moderation
ALIYUN_GREEN_IMAGE_SERVICE_AVATAR=profilePhotoCheck
ALIYUN_GREEN_IMAGE_SERVICE_GENERIC=baselineCheck
ALIYUN_GREEN_TIMEOUT_MS=15000
ALIYUN_GREEN_REGION=cn-shanghai
